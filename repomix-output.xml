          <thead class="bg-slate-800/50 text-xs uppercase text-gray-300">
            <tr>
              <th scope="col" class="px-6 py-4 font-semibold">Orden</th>
              <th scope="col" class="px-6 py-4 font-semibold">Fecha</th>
              <th scope="col" class="px-6 py-4 font-semibold">Total</th>
              <th scope="col" class="px-6 py-4 font-semibold">Estado Actual</th>
              <th scope="col" class="px-6 py-4 font-semibold text-center">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            @for (order of orders; track order.id) {
              <tr class="hover:bg-slate-800/20 transition-colors">
                
                <td class="px-6 py-4">
                  <span class="font-bold text-blue-400">#{{ order.orderNumber }}</span>
                </td>
                
                <td class="px-6 py-4">
                  {{ order.orderDate | date:'dd/MM/yyyy HH:mm' }}
                </td>
                
                <td class="px-6 py-4 text-white font-medium">
                  {{ order.total | currency:'COP':'symbol-narrow':'1.0-0' }}
