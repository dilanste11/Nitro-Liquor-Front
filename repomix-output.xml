        @for (item of orderItems; track item.productId; let i = $index) {
          <div class="flex items-center justify-between border border-gray-100 p-3 rounded-lg bg-white">
            <div class="flex-1">
              <p class="text-sm font-bold text-gray-800">{{ item.name }}</p>
              <!-- El precio de compra es fijo y de solo lectura -->
              <p class="text-xs text-gray-500">Costo Unit: {{ item.unitCost | currency:'COP':'symbol-narrow':'1.0-0' }}</p>
            </div>
            
            <div class="flex items-center gap-4">
              <!-- ÚNICO CAMPO EDITABLE: LA CANTIDAD -->
              <div class="flex items-center gap-2">
                <label class="text-xs font-semibold text-gray-500 uppercase">Cant:</label>
                <input type="number" [(ngModel)]="item.quantity" (ngModelChange)="updateItem(i)" min="1" 
                       class="w-20 px-2 py-1 border border-gray-300 rounded text-center focus:ring-blue-500 outline-none font-bold">
              </div>
              
              <div class="w-24 text-right">
                <p class="text-sm font-bold text-slate-700">{{ item.subtotal | currency:'COP':'symbol-narrow':'1.0-0' }}</p>
              </div>
              
              <button (click)="removeProduct(i)" class="text-red-500 hover:text-red-700 p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>
        }
      </div>
      
      <!-- Pie de Totales -->
      <div class="p-6 bg-slate-50 border-t border-gray-200">
        <div class="flex justify-between items-center mb-4">
          <span class="text-gray-600 font-medium">Total a Pagar al Proveedor</span>
          <span class="text-2xl font-bold text-slate-800">{{ orderTotal | currency:'COP':'symbol-narrow':'1.0-0' }}</span>
        </div>
        <button (click)="processOrder()" [disabled]="orderItems.length === 0 || !selectedSupplierId || isProcessing" 
                class="w-full bg-slate-800 hover:bg-slate-900 disabled:bg-slate-300 text-white font-bold py-4 rounded-xl shadow-md transition-colors text-lg">
          {{ isProcessing ? 'Procesando Ingreso...' : 'Confirmar Ingreso de Mercancía' }}
        </button>
      </div>
    </div>
    
  </div>
</div>
