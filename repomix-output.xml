                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-100 text-yellow-800">
                    {{ product.quantity }} unds
                  </span>
                }
                <!-- 3. Stock Saludable (Verde) -->
                @else {
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                    {{ product.quantity }} unds
                  </span>
                }
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <a [routerLink]="['/admin/products/edit', product.id]" class="text-blue-500 hover:text-blue-700 font-medium text-sm">Editar</a>
                <button class="text-red-500 hover:text-red-700 font-medium text-sm">Eliminar</button>
              </td>
            </tr>
          }
        }
        
      </tbody>
    </table>
  </div>
</div>
