<div class="space-y-8">
  
  <!-- BANNER PROMOCIONAL -->
  <div class="relative rounded-2xl overflow-hidden bg-slate-900 text-white shadow-xl h-64 md:h-80 flex items-center">
    <!-- Un fondo abstracto o imagen de licores (puedes cambiar la URL después) -->
    <div class="absolute inset-0 opacity-40 bg-[url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center"></div>
    <div class="relative z-10 p-8 md:p-12 w-full md:w-2/3">
      <span class="inline-block px-3 py-1 bg-blue-600 text-xs font-bold rounded-full mb-4 uppercase tracking-wider">Lanzamiento</span>
      <h1 class="text-4xl md:text-5xl font-black mb-4 leading-tight">Los mejores licores, <br> directo a tu puerta.</h1>
      <p class="text-gray-300 text-lg">Explora nuestro catálogo premium y disfruta de entregas rápidas.</p>
    </div>
  </div>

  <!-- SECCIÓN DE PRODUCTOS -->
  <div>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-gray-800">Catálogo Disponible</h2>
    </div>

    @if (isLoading) {
      <div class="flex justify-center items-center py-20">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
      </div>
    } @else {
      <!-- Grilla de productos responsiva (1 col en móvil, 2 en tablet, 4 en desktop) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        @for (product of products; track product.id) {
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow group flex flex-col h-full">
            
            <!-- Contenedor de Imagen -->
            <div class="h-56 bg-gray-50 p-6 relative flex items-center justify-center">
              @if (product.quantity <= 0) {
                <span class="absolute top-3 right-3 bg-red-100 text-red-700 text-xs font-bold px-2 py-1 rounded-full z-10">Agotado</span>
              }
              
              @if (product.imageUrl) {
                <img [src]="product.imageUrl" [alt]="product.name" 
                     class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300">
              } @else {
                <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              }
            </div>

            <!-- Información del Producto -->
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-bold text-gray-800 text-lg mb-1 line-clamp-2">{{ product.name }}</h3>
              <p class="text-sm text-gray-500 mb-4 line-clamp-2">{{ product.description || 'Sin descripción disponible.' }}</p>
              
              <div class="mt-auto flex items-center justify-between">
