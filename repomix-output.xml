                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-xs font-bold border border-transparent" 
                        [ngClass]="getStatusColor(order.status)">
                    <!-- Mostramos el nombre del estado actual estáticamente si lo necesitas, o dejamos que el select hable por sí solo -->
                    <select [(ngModel)]="order.status" 
                            (ngModelChange)="onStatusChange(order.id, $event)"
                            class="bg-transparent text-inherit font-bold outline-none cursor-pointer appearance-none">
                      @for (opt of statusOptions; track opt.value) {
                        <option [value]="opt.value" class="bg-slate-800 text-white">{{ opt.label }}</option>
                      }
                    </select>
                  </span>
                </td>

                <td class="px-6 py-4 text-center">
                  <button (click)="openOrderDetails(order.id)" class="text-gray-400 hover:text-white transition-colors p-2" title="Ver Detalles">
                    <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
